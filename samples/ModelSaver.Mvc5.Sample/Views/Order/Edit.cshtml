@model ModelSaver.Mvc5.Sample.Models.OrderEditModel
@using ModelSaver.Mvc5
@{
    ViewBag.Title = "Edit Order";
}

<h1>Edit Order (ASP.NET MVC 5)</h1>

<h2>Model as it arrives at the client</h2>

<dl>
    <dt>Id</dt>
    <dd>@Model.Id</dd>

    <dt>CustomerId</dt>
    <dd>@Model.CustomerId</dd>

    <dt>CreatedAtUtc</dt>
    <dd>@Model.CreatedAtUtc</dd>

    <dt>Total</dt>
    <dd>@Model.Total</dd>

    <dt>CustomerName</dt>
    <dd>@Model.CustomerName</dd>

    <dt>ShippingAddress.Street</dt>
    <dd>@Model.ShippingAddress.Street</dd>

    <dt>ShippingAddress.City</dt>
    <dd>@Model.ShippingAddress.City</dd>

    <dt>ShippingAddress.PostalCode</dt>
    <dd>"@Model.ShippingAddress.PostalCode"</dd>

    <dt>ShippingAddress.Location.Latitude</dt>
    <dd>@Model.ShippingAddress.Location.Latitude</dd>

    <dt>ShippingAddress.Location.Longitude</dt>
    <dd>@Model.ShippingAddress.Location.Longitude</dd>

    <dt>ShippingAddress.DeliveryInstructions (marked <code>[PersistOnPostback(false)]</code>)</dt>
    <dd>"@Model.ShippingAddress.DeliveryInstructions"</dd>

    <dt>DisplayOnlySummary (marked <code>[PersistOnPostback(false)]</code>)</dt>
    <dd>"@Model.DisplayOnlySummary"</dd>
</dl>

<p>
    Only <strong>Customer name</strong> and <strong>City</strong> are editable
    fields in the form below. Every other value listed above - including the
    nested <code>ShippingAddress.*</code> and
    <code>ShippingAddress.Location.*</code> properties - is not on the form;
    <code>Html.BeginPersistedForm</code> adds them as hidden fields because the model types are marked
    <code>[PersistOnPostback]</code>. Properties opted out with
    <code>[PersistOnPostback(false)]</code> are not sent back.
</p>

@using (Html.BeginPersistedForm(Model, "Save", "Order"))
{
    @Html.LabelFor(m => m.CustomerName, "Customer name")
    @Html.TextBoxFor(m => m.CustomerName)

    @Html.LabelFor(m => m.ShippingAddress.City, "City")
    @Html.TextBoxFor(m => m.ShippingAddress.City)

    <button type="submit">Save</button>
}
