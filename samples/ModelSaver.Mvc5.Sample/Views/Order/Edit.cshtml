@model ModelSaver.Mvc5.Sample.Models.OrderEditModel
@using ModelSaver.Mvc5
@{
    ViewBag.Title = "Edit Order";
}

<h1>Edit Order (ASP.NET MVC 5)</h1>

<p>
    Only <strong>Customer name</strong> is shown as an editable field below.
    <code>Id</code>, <code>CustomerId</code>, <code>CreatedAtUtc</code> and
    <code>Total</code> are not on the form at all -
    <code>Html.BeginPersistedForm</code> adds them as hidden fields
    automatically because <code>OrderEditModel</code> is marked
    <code>[PersistOnPostback]</code>.
</p>

<dl>
    <dt>DisplayOnlySummary (marked <code>[PersistOnPostback(false)]</code>)</dt>
    <dd>@Model.DisplayOnlySummary</dd>
</dl>

@using (Html.BeginPersistedForm(Model, "Save", "Order"))
{
    @Html.LabelFor(m => m.CustomerName, "Customer name")
    @Html.TextBoxFor(m => m.CustomerName)

    <button type="submit">Save</button>
}
